/////////////////////////////////////////////////////////////////// SPI COMMANDS

CMD0	EQU	 0|#40
CMD1	EQU	 1|#40
CMD8	EQU	 8|#40
CMD9	EQU	 9|#40
CMD10	EQU	10|#40
CMD12	EQU	12|#40
CMD16	EQU	16|#40
CMD17	EQU	17|#40
CMD18	EQU	18|#40
CMD24	EQU	24|#40
CMD25	EQU	25|#40
CMD55	EQU	55|#40
CMD58	EQU	58|#40
ACMD23	EQU	23|#40
ACMD41	EQU	41|#40

SDCRESET	SUBRO /////////////////////////////////////////////////// SD CARD RESET

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

//	SEND CLOCK PULSES

	LD	B,10
.INICLK	LD	A,#FF		; MOSI = 1
	OUT	(SPIDAT),A
	DJNZ	.INICLK

//	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

//	TRY 16 TIMES TO SEND CMD0

	LD	B,16
.CMD0X16	LD	A,CMD0
	LD	DE,0
	PUSH	BC
	CALL	MMCCMD2T
	POP	BC
	JP	NC,.TSTV2
	DJNZ	.CMD0X16

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	SCF
	RET

.TSTV2	LD	A,CMD8
	LD	DE,#01AA
	CALL	MMCCMD23
	LD	HL,MMCCMD1
	JR	C,.SKIP4
	LD	HL,MMCACM41
.SKIP4	LD	BC,120

.LOOP	PUSH	BC
	CALL	JUMPHL
	POP	BC
	JP	NC,INIT
	DJNZ	.LOOP
	DEC	C
	JR	NZ,.LOOP

ERR

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	SCF
	RET

JUMPHL	JP	(HL)

INIT	LD	A,CMD58
	LD	DE,0
	CALL	MMCCMD23
	JP	C,ERR
	LD	A,B
	AND	#40
	LD	(MMCVER),A
	CALL	Z,MMCST512

	LD	A,#FF
	OUT	(SPICON),A

	AND	A
	RET

MMCST512	SUBRO ///////////////////////////////// MMC SET BLOCK SIZE TO 512 BYTES

	LD	A,CMD16
	LD	BC,0
	LD	DE,512
	JP	MMCCMDGE

SDCREAD	SUBRO ////////////////////////////////////////////// SD CARD READ BLOCK

;	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

;	CONVERT BLOCKS TO BYTES ACCORDING TO VERSION

	LD	A,(MMCVER)
	AND	A
	CALL	Z,MMCBYTES

;	READ BLOCK

	LD	A,CMD17
	CALL	MMCCMDGE
	RET	C

;	WAIT FE RESPONSE

	CALL	MMCWRFE
	RET	C

	LD	BC,SPIDAT
	INIR
	INIR

//	DISCARD CRC

	NOP
	IN	A,(SPIDAT)
	NOP
	IN	A,(SPIDAT)

	AND	A
	RET

MMCBYTES	SUBRO ///////////////////////////////////// MMC CONVERT BLOCKS TO BYTES

	LD	B,C
	LD	C,D
	LD	D,E
	LD	E,0
	SLA	D
	RL	C
	RL	B

	RET

MMCCMD1	SUBRO /////////////////////////////////////////////////// MMC SEND CMD1

	LD	A,CMD1

MMCCMDNA	LD	BC,0
	LD	D,B
	LD	E,C

MMCCMDGE	CALL	MMCCMD
	AND	A
	RET	Z
;	FALL THRU ERROR

MMCERROR	SCF
	RET

MMCACM41	SUBRO ///////////////////////////////////////////////// MMC SEND ACMD41

	LD	A,CMD55
	CALL	MMCCMDNA
	LD	A,ACMD41
	LD	BC,#4000
	LD	D,C
	LD	E,C
	JR	MMCCMDGE

MMCCMD2T	SUBRO ////////////////////////////// MMC SEND COMMAND 2 BYTES TEST BUSY

	LD	BC,0
	CALL	MMCCMD
	LD	B,A
	AND	#FE	; TEST BIT 0 (BUSY)
	LD	A,B
	JR	NZ,MMCERROR
	RET

MMCCMD23	SUBRO ///////////////////////////////// MMC SEND COMMAND 2 BYTES GET R3

	CALL	MMCCMD2T
	RET	C

	PUSH	AF
	CALL	MMCWRNFF
	LD	H,A
	CALL	MMCWRNFF
	LD	L,A
	CALL	MMCWRNFF
	LD	D,A
	CALL	MMCWRNFF
	LD	E,A
	LD	B,H
	LD	C,L
	POP	AF
	RET

MMCCMD	SUBRO //////////////////////////////////////////////// MMC SEND COMMAND

	OUT	(SPIDAT),A
	PUSH	AF
	LD	A,B
	NOP
	OUT	(SPIDAT),A
	LD	A,C
	NOP
	OUT	(SPIDAT),A
	LD	A,D
	NOP
	OUT	(SPIDAT),A
	LD	A,E
	NOP
	OUT	(SPIDAT),A
	POP	AF
	CP	CMD0
	LD	B,#95
	JR	Z,.CRC
	CP	CMD8
	LD	B,#87
	JR	Z,.CRC
	LD	B,#FF

.CRC	LD	A,B
	OUT	(SPIDAT),A
	JR	MMCWRNFF

MMCWRFE	SUBRO /////////////////////////////////////////// MMC WAIT RESPONSE #FE

	LD	B,10

.POLL	PUSH	BC
	CALL	MMCWRNFF
	POP	BC

	CP	#FE
	RET	Z

	DJNZ	.POLL

	SCF
	RET

MMCWRNFF	SUBRO /////////////////////////////////////// MMC WAIT RESPONSE NOT #FF

	LD	BC,100

.POLL	IN	A,(SPIDAT)
	CP	#FF
	RET	NZ
	DJNZ	.POLL

	DEC	C
	JR	NZ,.POLL

	RET

////////////////////////////////////////////////////////////////////////////////