////////////////////////////////////////////////////////////////////////////////

VDPIMG	DEFB	%00000000
	DEFB	%10000010	; 16K VRAM | 16 X 16 SPRITES
	DEFB	PNTBAS>>10
	DEFB	PCTBAS>> 6
	DEFB	PGTBAS>>11
	DEFB	SATBAS>> 7
	DEFB	SGTBAS>>11
	DEFB	#00

PGTDAT	INCBIN	"PGT.BIN"

PCTDAT	DEFS	 2,#30
	DEFS	30,#F0

	IF	DIPCORE!=0
STRBIOS	DEFM	"COLECO  BIO"	; STRING BIOS
	ENDIF

	IF	DIPCORE=1
STRMULT	DEFM	"MULTCARTROM"	; STRING MULTI CART
	ENDIF

	IF	DIPCORE=2
STRDK	DEFM	"DKONG   ROM"	; STRING CART DONKEY KONG
	ENDIF

	IF	DIPCORE=3
STRBT	DEFM	"BURGER  ROM"	; STRING CART BURGER TIME
	ENDIF

	IF	DIPCORE=0
STRCOR00	DEFM	"CORE00  PHX"	; STRING CORE 00
STRCOR01	DEFM	"CORE01  PHX"	; STRING CORE 01
STRCOR02	DEFM	"CORE02  PHX"	; STRING CORE 02
STRCOR03	DEFM	"CORE03  PHX"	; STRING CORE 03
STRCOR04	DEFM	"CORE04  PHX"	; STRING CORE 04
STRCOR05	DEFM	"CORE05  PHX"	; STRING CORE 05
STRCOR06	DEFM	"CORE06  PHX"	; STRING CORE 06
STRCOR07	DEFM	"CORE07  PHX"	; STRING CORE 07
STRCOR08	DEFM	"CORE08  PHX"	; STRING CORE 08
STRCOR09	DEFM	"CORE09  PHX"	; STRING CORE 09
	ENDIF

STREND	DEFM	"OK",0

STRFAT16	DEFM	"FAT16   "
STRFAT32	DEFM	"FAT32   "

STRTTL	DEFM	"PHOENIX FIRMWARE STAGE -1",0

STRFAT0	DEFM	"SD CARD VOLUME      WAIT",0
STRFAT1	DEFM	"BIOS FILE           WAIT",0
STRFAT2	DEFM	"CART FILE           WAIT",0

STROK	DEFM	"OK  ",0
STRBAD	DEFM	"BAD ",0

////////////////////////////////////////////////////////////////////////////////