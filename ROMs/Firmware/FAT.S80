////////////////////////////////////////////////////////////////////////////////

FAT32	EQU	0

	MAP	0

DIRNAM	#	8	; NAME
DIREXT	#	3	; EXTENSION
DIRATR	#	1	; ATTRIBUTES
DIRLOW	#	1	; LOWERCASE FLAGS
DIR100	#	1	; 100TH OF SECOND
DIRTIM	#	2	; CREATE TIME
DIRDAT	#	2	; CREATE DATE
DIRACC	#	2	; ACCESS DATE
DIRCLUH	#	2	; CLUSTER MSB
DIRTMOD	#	2	; MODIFY TIME
DIRDMOD	#	2	; MODIFY DATE
DIRSCLU	#	2	; STARTING CLUSTER
DIRSIZ	#	4	; FILE SIZE
DIRENTSZ	#

	ENDMAP

	MAP	0

FATFLG	#	1	; FAT FLAGS
VARSZ	#		; VARIABLES SIZE

	ENDMAP

FATRESET	SUBRO /////////////////////////////////////////////////// SD CARD RESET

;	RESET SD CARD

	CALL	SDCRESET
	RET	C

;	LOAD MBR

	LD	HL,SECBUF
	LD	DE,0
	LD	BC,0
	CALL	SDCREAD
	RET	C

;	LOAD VBR

	LD	HL,SECBUF
	LD	DE,(SECBUF+#01C6)
	LD	BC,(SECBUF+#01C8)
	LD	(VBRBAS+0),DE
	LD	(VBRBAS+2),BC
	CALL	SDCREAD
	RET	C

;	CHECK FAT16/32

	LD	HL,SECBUF+#0036
	LD	DE,STRFAT16
	LD	BC,8
	CALL	COMPARE
	JR	Z,.FAT16
;	SET	FAT32,(IY+FATFLG)
	SCF
	RET
.FAT16
;	CLUSTER SIZE

	LD	A,(SECBUF+13)
	LD	(CLUSIZ),A

;	FAT START

	LD	HL,(VBRBAS+0)
	LD	DE,(SECBUF+#000E)
	ADD	HL,DE
	LD	(FATBAS+0),HL

	LD	HL,(VBRBAS+2)
	LD	DE,0
	ADC	HL,DE
	LD	(FATBAS+2),HL

;	FAT NUMBER

	LD	A,(SECBUF+#0010)
	LD	(FATNUM),A

;	DIRECTORY ENTRY

	LD	HL,(SECBUF+17)
	LD	(DIRENT),HL

;	ROOT DIRECTORY SIZE

[5]	ADD	HL,HL
	LD	DE,511
	ADD	HL,DE
	REPEAT	9
	SRL	H
	RR	L
	ENDREPEAT
	LD	A,L
	LD	(ROTSIZ),A

;	FAT SIZE

	LD	HL,(SECBUF+22)
	LD	(FATSIZ),HL

;	ROOT DIRECTORY START

	LD	HL,(FATSIZ)
	LD	A,(FATNUM)
	LD	B,A
	EX	DE,HL
	LD	HL,0
	EXX
	LD	HL,0
	LD	DE,0
	EXX
.MUL	ADD	HL,DE
	EXX
	ADC	HL,DE
	EXX
	DJNZ	.MUL

;	ROOT DIRECTORY CLUSTER

	XOR	A
	LD	(ROTCLU+0),A
	LD	(ROTCLU+1),A
	LD	(ROTCLU+2),A
	LD	(ROTCLU+3),A

;	ROOT DIRECTORY BASE

	LD	DE,(FATBAS+0)
	ADD	HL,DE
	LD	(ROTBAS),HL

	EXX
	LD	DE,(FATBAS+2)
	ADC	HL,DE
	LD	(ROTBAS+2),HL
	EXX

;	DATA BASE

	LD	A,(ROTSIZ)
	LD	E,A
	LD	D,0
	ADD	HL,DE
	LD	(DATBAS+0),HL

	EXX
	LD	DE,0
	ADC	HL,DE
	LD	(DATBAS+2),HL
	EXX

	RET

FATOPEN	SUBRO //////////////////////////////////////////////////////// FAT OPEN

;	STORE FILENAME POINTER

	LD	(FILENAME),HL

;	DIRECTORY CLUSTER = ROOT DIRECTORY CLUSTER

	LD	HL,(ROTCLU+0)
	LD	(DIRCLU+0),HL
	LD	HL,(ROTCLU+2)
	LD	(DIRCLU+2),HL

;	DIRECTORY SECTOR = ROOT DIRECTORY BASE

	LD	HL,(ROTBAS+0)
	LD	(DIRSEC+0),HL
	LD	HL,(ROTBAS+2)
	LD	(DIRSEC+2),HL

;	NUMBER OF DIRECTORY ENTRIES

	LD	A,(ROTSIZ)
	LD	L,A
	LD	H,0
[4]	ADD	HL,HL
	LD	C,L
	LD	B,H

;	LD	BC,24	; OJO

	LD	HL,0
	LD	(ENTRY),HL

;	LDXY	0,0
;	LD	(PNTPTR),DE

;.WH1	PUSH	BC

.LOOKUP	PUSH	BC

	LD	A,(ENTRY)
	AND	#0F
	JR	NZ,.ELSELD

	LD	HL,SECBUF
	LD	DE,(DIRSEC+0)
	LD	BC,(DIRSEC+2)
	CALL	SDCREAD

	LD	HL,(DIRSEC+0)
	LD	DE,1
	ADD	HL,DE
	LD	(DIRSEC+0),HL
	LD	HL,(DIRSEC+2)
	DEC	DE
	ADC	HL,DE
	LD	(DIRSEC+2),HL

	LD	HL,SECBUF
	LD	(SECPTR),HL

	JR	.SKLD
.ELSELD
;	NEXT DIRECTORY ENTRY

	LD	HL,(SECPTR)
	LD	DE,DIRENTSZ
	ADD	HL,DE
	LD	(SECPTR),HL
.SKLD
;	DISCARD EMPTY & DELETED ENTRIES

	LD	IX,(SECPTR)
	LD	A,(IX+0)
	AND	A
	JP	Z,.SKENT
	CP	#E5
	JR	Z,.SKENT

;	DISCARD VOLUMES & DIRECTORIES

	LD	A,(IX+DIRATR)
	AND	#18
	JR	NZ,.SKENT

;	COMPARE NAME.EXT

	PUSH	IX
	POP	HL
	LD	DE,(FILENAME)
	LD	BC,11
	CALL	COMPARE
	JR	NZ,.SKENT
/*
         file->size = pEntry->FileSize;
         file->cluster = pEntry->StartCluster + (fat32 ? ((unsigned long)(pEntry->HighCluster & 0x0FFF)) << 16 : 0);
         file->sector = 0;
*/
	POP	BC
	AND	A
	RET
.SKENT
	LD	HL,(ENTRY)
	INC	HL
	LD	(ENTRY),HL

	POP	BC
	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.LOOKUP

	SCF
	RET

FATREAD	SUBRO //////////////////////////////////////////////////////// FAT READ

;	DE: START CLUSTER - 2 (FAT16 = 16-BIT)

	LD	L,(IX+DIRSCLU+0)
	LD	H,(IX+DIRSCLU+1)
	DEC	HL
	DEC	HL
	EX	DE,HL

	LD	HL,0
	EXX
	LD	HL,0
	LD	DE,0
	EXX
	LD	A,(CLUSIZ)
	LD	B,A
.CLUMUL	ADD	HL,DE
	EXX
	ADC	HL,DE
	EXX
	DJNZ	.CLUMUL

	LD	DE,(DATBAS+0)
	ADD	HL,DE
	LD	(FILSEC+0),HL
	EXX
	LD	DE,(DATBAS+2)
	ADC	HL,DE
	LD	(FILSEC+2),HL
	EXX

	LD	DE,(FILSEC+0)
	LD	BC,(FILSEC+2)
	LD	HL,SECBUF
	CALL	SDCREAD

;	LD	A,SPC
;	OUT	(VDPDAT),A

	LD	HL,SECBUF
	LD	BC,#0000|VDPDAT
[2]	OTIR

	LD	HL,(PNTPTR)
	LD	DE,32
	ADD	HL,DE
	LD	(PNTPTR),HL
.SKENT
	LD	HL,(SECPTR)
	LD	DE,DIRENTSZ
	ADD	HL,DE
	LD	(SECPTR),HL

	RET

////////////////////////////////////////////////////////////////////////////////