///////////////////////////////////////////////////////////////////////// MACROS

	MACRO	SUBRO
	ENDMACRO

	MACRO	PAD ADDR
	DEFS	ADDR-$,#FF
	ENDMACRO

	MACRO	LDXY X,Y
	LD	DE,PNTBAS+(Y*32)+X
	ENDMACRO

//////////////////////////////////////////////////////////////////////// EQUATES

FAT32	EQU	0

PGTBAS	EQU	#0000	; PATTERN GENERATOR TABLE BASE
SGTBAS	EQU	#0800	; SPRITE  GENERATOR TABLE BASE
PNTBAS	EQU	#1000	; PATTERN NAME      TABLE BASE
SATBAS	EQU	#1300	; SPRITE  ATTRIBUTE TABLE BASE
PCTBAS	EQU	#1380	; PATTERN COLOR     TABLE BASE

PGTLEN	EQU	2048	; PATTERN GENERATOR TABLE LENGTH
SGTLEN	EQU	2048	; SPRITE  GENERATOR TABLE LENGTH
PNTLEN	EQU	 768	; PATTERN NAME      TABLE LENGTH
SATLEN	EQU	 128	; SPRITE  ATTRIBUTE TABLE LENGTH
PCTLEN	EQU	  32	; PATTERN COLOR     TABLE LENGTH

SPC	EQU	' '	; SPACE

//////////////////////////////////////////////////////////////////////// STRUCTS

	MAP	0

DIRNAM	#	8	; NAME
DIREXT	#	3	; EXTENSION
DIRATR	#	1	; ATTRIBUTES
DIRLOW	#	1	; LOWERCASE FLAGS
DIR100	#	1	; 100TH OF SECOND
DIRTIM	#	2	; CREATE TIME
DIRDAT	#	2	; CREATE DATE
DIRACC	#	2	; ACCESS DATE
DIRCLUH	#	2	; CLUSTER MSB
DIRTMOD	#	2	; MODIFY TIME
DIRDMOD	#	2	; MODIFY DATE
DIRSCLU	#	2	; STARTING CLUSTER
DIRSIZ	#	4	; FILE SIZE
DIRSZOF	#

	ENDMAP

	MAP	0

FATFLG	#	1	; FAT FLAGS
VARSZ	#		; VARIABLES SIZE

	ENDMAP

	MAP	RAMBAS

SECBUF	#	512	; SECTOR BUFFER

CLUSIZ	#	1	; CLUSTER SIZE
DATBAS	#	4	; DATA BASE
DIRCLU	#	4	; DIRECTORY CLUSTER
DIRSEC	#	4	; DIRECTORY SECTOR
DIRENT	#	2	; DIRECTORY ENTRIES
ENTRY	#	2	; ENTRY INDEX
FATBAS	#	4	; FAT BASE
FATNUM	#	1	; NUMBER OF FATS
FATSIZ	#	2	; FAT SIZE
MMCVER	#	1	; MMC VERSION
PNTPTR	#	2	; PATTERN NAME TABLE POINTER
ROTBAS	#	4	; ROOT DIRECTORY BASE
ROTCLU	#	4	; ROOT DIRECTORY CLUSTER
ROTSIZ	#	1	; ROOT DIRECTORY SIZE
SECPTR	#	2	; SECTOR POINTER
VBRBAS	#	4	; VBR BASE

VARS	#	VARSZ	; VARIABLES

	ENDMAP

///////////////////////////////////////////////////////////////////// MEMORY MAP

RAMBAS	EQU	#7000	; RAM BASE
RAMLEN	EQU	#0400	; RAM LENGTH

//////////////////////////////////////////////////////////////////////// I/O MAP

SYSCON	EQU	#55	; -W- SYSTEM CONTROL
JOYSET	EQU	#80	; -W- JOYPAD SET
VDPDAT	EQU	#BE	; RW- VDP DATA
VDPREG	EQU	#BF	; RW- VDP REGISTER SELECT / STATUS READ
JOYRES	EQU	#C0	; -W- JOYPAD RESET
JOY0DATS	EQU	#FC	; R-- JOYPAD 0
JOY1DATS	EQU	#FF	; R-- JOYPAD 1
PSGDAT	EQU	#FF	; -W- PSG DATA

////////////////////////////////////////////////////////////////////// PAGE ZERO

	ORG	#0000

	LD	SP,RAMBAS+RAMLEN
	DI
	JP	START
	
	PAD	#0008
	RET

	PAD	#0010
	RET

	PAD	#0018
	RET

	PAD	#0020
	RET

	PAD	#0028
	RET

	PAD	#0030
	RET

//////////////////////////////////////////////////////////////////////////// INT

	PAD	#0038
	EI
	RET

//////////////////////////////////////////////////////////////////////////// NMI

	PAD	#0066

	PUSH	AF
	IN	A,(VDPREG)
	POP	AF
	RETN

START	LD	IY,VARS

;	MUTE PSG ASAP (80 CYCLES)

	LD	A,%10011111
	OUT	(PSGDAT),A
	LD	A,%10111111
	OUT	(PSGDAT),A
	LD	A,%11011111
	OUT	(PSGDAT),A
	LD	A,%11111111
	OUT	(PSGDAT),A

;	CLEAR RAM

	LD	HL,RAMBAS
	LD	DE,RAMBAS+1
	LD	BC,RAMLEN-1
	LD	(HL),0
	LDIR

;	LOAD VDP IMAGE

	LD	HL,VDPIMG
	LD	BC,#0800|VDPREG
	LD	A,#80-1
.REG	INC	A		;  4 /  5 = 30
	OUTI			; 16 / 18
	JP	.WAIT		; 10 / 11 = 29
.WAIT	OUT	(VDPREG),A	; 11 / 12
	JR	NZ,.REG		; 12 / 13

;	UPLOAD GRAPHICS

	LD	HL,PGTDAT
	LD	DE,PGTBAS
	LD	BC,PGTLEN
	CALL	VDPCOPY

	LD	HL,PCTDAT
	LD	DE,PCTBAS
	LD	B,PCTLEN
	CALL	VDPCOPYQ
/*
	LD	HL,SPRDAT
	LD	DE,SGTBAS
	LD	BC,SGTLEN
	CALL	VDPCOPY
*/
	CALL	VDPCLS

	LD	HL,STRTTL
	LDXY	4,5
	CALL	VDPPRINT

;	ENABLE VIDEO+NMI

	IN	A,(VDPREG)

	LD	A,%10100010	; ENABLE INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

	HALT

;	LD	A,%11100010	; ENABLE DISPLAY & INT
	LD	A,%11000010	; ENABLE DISPLAY & NOT INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

;	SD CARD HANDSHAKE

	LD	HL,STRMMC0
	LDXY	4,8
	CALL	VDPPRINT

	CALL	MMCRESET
	JR	NC,.PART

	LD	HL,STRBAD
	LDXY	24,8
	CALL	VDPPRINT

	JP	HANGON

.PART

	LD	HL,STROK
	LDXY	24,8
	CALL	VDPPRINT

	LD	HL,STRMMC1
	LDXY	4,10
	CALL	VDPPRINT

	LD	HL,SECBUF
	LD	DE,0
	LD	BC,0
	CALL	MMCREAD
	JR	NC,.GOAHEAD

	LD	HL,STRBAD
	LDXY	24,10
	CALL	VDPPRINT

	JP	HANGON

.GOAHEAD

	LD	HL,STROK
	LDXY	24,10
	CALL	VDPPRINT

;	TODO: CHECK 55AA

;	LOAD BOOT

	LD	HL,SECBUF
	LD	DE,(SECBUF+#01C6)
	LD	BC,(SECBUF+#01C8)
	LD	(VBRBAS+0),DE
	LD	(VBRBAS+2),BC
	CALL	MMCREAD

;	CHECK FAT16/32

	LD	HL,SECBUF+#0036
	LD	DE,STRFAT16
	LD	BC,8
	CALL	COMPARE
	JR	Z,.FAT16

	SET	FAT32,(IY+FATFLG)
.FAT16
;	CALCULATE PARMS

;	CLUSTER SIZE

	LD	A,(SECBUF+13)
	LD	(CLUSIZ),A

;	FAT START

	LD	HL,(VBRBAS+0)
	LD	DE,(SECBUF+#000E)
	ADD	HL,DE
	LD	(FATBAS+0),HL

	LD	HL,(VBRBAS+2)
	LD	DE,0
	ADC	HL,DE
	LD	(FATBAS+2),HL

;	FAT NUMBER

	LD	A,(SECBUF+#0010)
	LD	(FATNUM),A
/*
	LD	L,A
	LD	H,0
[4]	ADD	HL,HL
*/
	LD	HL,(SECBUF+17)
	LD	(DIRENT),HL

;	ROOT DIRECTORY SIZE

[5]	ADD	HL,HL
	LD	DE,511
	ADD	HL,DE
	REPEAT	9
	SRL	H
	RR	L
	ENDREPEAT

	LD	A,L
	LD	(ROTSIZ),A

;	FAT SIZE

	LD	HL,(SECBUF+22)
	LD	(FATSIZ),HL

;	ROOT DIRECTORY START
/*
	LD	A,H
	LDXY	0,0
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT

	LD	A,(FATNUM)
	LDXY	0,1
	CALL	BCDPUTAT
*/
	LD	HL,(FATSIZ)
	LD	A,(FATNUM)
	LD	B,A
	EX	DE,HL
	LD	HL,0
	EXX
	LD	HL,0
	LD	DE,0
	EXX
.MUL	ADD	HL,DE
	EXX
	ADC	HL,DE
	EXX
	DJNZ	.MUL
/*
	EXX
	LD	A,H
	LDXY	0,2
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	EXX

	LD	A,H
	CALL	BCDPUT
	LD	A,L
	CALL	BCDPUT
*/
;	ROOT DIRECTORY CLUSTER

	XOR	A
	LD	(ROTCLU+0),A
	LD	(ROTCLU+1),A
	LD	(ROTCLU+2),A
	LD	(ROTCLU+3),A

;	ROOT DIRECTORY BASE

	LD	DE,(FATBAS+0)
	ADD	HL,DE
	LD	(ROTBAS),HL

	EXX
	LD	DE,(FATBAS+2)
	ADC	HL,DE
	LD	(ROTBAS+2),HL
	EXX

;	DATA BASE

	LD	A,(ROTSIZ)
	LD	E,A
	LD	D,0
	ADD	HL,DE
	LD	(DATBAS+0),HL

	EXX
	LD	DE,0
	ADC	HL,DE
	LD	(DATBAS+2),HL
	EXX

;	OPEN FILE

	CALL	VDPCLS


	LD	HL,(ROTCLU+0)
	LD	(DIRCLU+0),HL
	LD	HL,(ROTCLU+2)
	LD	(DIRCLU+2),HL

	LD	HL,(ROTBAS+0)
	LD	(DIRSEC+0),HL
	LD	HL,(ROTBAS+2)
	LD	(DIRSEC+2),HL

	LD	A,(ROTSIZ)
	LD	L,A
	LD	H,0
[4]	ADD	HL,HL
	LD	C,L
	LD	B,H

	LD	BC,24	; OJO

	LD	HL,0
	LD	(ENTRY),HL

	LDXY	0,0
	LD	(PNTPTR),DE

.WH1	PUSH	BC

.LOOKUP	PUSH	BC

	LD	A,(ENTRY)
	AND	#0F
	JR	NZ,.SKLD

	LD	HL,SECBUF
	LD	DE,(DIRSEC+0)
	LD	BC,(DIRSEC+2)
	CALL	MMCREAD
	LD	HL,(DIRSEC+0)
	LD	DE,1
	ADD	HL,DE
	LD	(DIRSEC+0),HL
	LD	HL,(DIRSEC+2)
	DEC	DE
	ADC	HL,DE
	LD	(DIRSEC+2),HL

	LD	HL,SECBUF
	LD	(SECPTR),HL

.SKLD

	LD	DE,(PNTPTR)
	CALL	VDPSETW
	LD	HL,(SECPTR)
	LD	IX,(SECPTR)
	LD	A,(HL)
	AND	A
	JR	Z,.SKENT
	CP	#E5
	JR	Z,.SKENT
	LD	A,(IX+#0B)
	AND	#08
;	CP	#0F
;	JR	NZ,.SKENT
	LD	BC,#0B00|VDPDAT
	OTIR

	LD	HL,(PNTPTR)
	LD	DE,32
	ADD	HL,DE
	LD	(PNTPTR),HL
.SKENT
	LD	HL,(SECPTR)
	LD	DE,DIRSZOF
	ADD	HL,DE
	LD	(SECPTR),HL





	POP	BC

	LD	HL,(ENTRY)
	INC	HL
	LD	(ENTRY),HL

	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,.LOOKUP


	HALT


	POP	BC
	JR	.WH1
/*
	EXX
	LD	A,H
	LDXY	0,3
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	EXX

	LD	A,H
	CALL	BCDPUT
	LD	A,L
	CALL	BCDPUT
*/
/*
	LD	HL,SECBUF+#0180
	LDXY	0,4
	LD	B,16
.ROW	LD	A,H
	SUB	#70
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	LD	A,' '
	OUT	(VDPDAT),A
	LD	C,8
.B	LD	A,(HL)
	INC	HL
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	DEC	C
	JR	NZ,.B
	PUSH	HL
	LD	HL,32
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	DJNZ	.ROW
*/
HANGON	JR	HANGON

BCDPUTAT	CALL	VDPSETW
BCDPUT	PUSH	AF
[4]	SRL	A
	OUT	(VDPDAT),A
	POP	AF
	AND	#0F
	OUT	(VDPDAT),A
	RET

;	UPLOAD JUMPER CODE TO RAM
/*
	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS
*/
;	JUMPER CODE

JUMPER	LD	A,%00000000
	OUT	(SYSCON),A

	JP	0

JUMPERE

COMPARE	LD	A,B
	OR	C
	RET	Z

	LD	A,(DE)
	CP	(HL)
	RET	NZ

	INC	HL
	INC	DE
	DEC	BC

	JR	COMPARE

//////////////////////////////////////////////////////////////////////// I/O MAP

SPICON	EQU	#56
SPIDAT	EQU	#57

/////////////////////////////////////////////////////////////////// SPI COMMANDS

CMD0	EQU	 0|#40
CMD1	EQU	 1|#40
CMD8	EQU	 8|#40
CMD9	EQU	 9|#40
CMD10	EQU	10|#40
CMD12	EQU	12|#40
CMD16	EQU	16|#40
CMD17	EQU	17|#40
CMD18	EQU	18|#40
CMD24	EQU	24|#40
CMD25	EQU	25|#40
CMD55	EQU	55|#40
CMD58	EQU	58|#40
ACMD23	EQU	23|#40
ACMD41	EQU	41|#40

MMCRESET	SUBRO /////////////////////////////////////////////////////// MMC RESET

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

//	SEND CLOCK PULSES

	LD	B,10
.INICLK	LD	A,#FF		; MOSI = 1
	OUT	(SPIDAT),A
	DJNZ	.INICLK

//	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

//	TRY 16 TIMES TO SEND CMD0

	LD	B,16
.CMD0X16	LD	A,CMD0
	LD	DE,0
	PUSH	BC
	CALL	MMCCMD2T
	POP	BC
	JP	NC,.TSTV2
	DJNZ	.CMD0X16

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	SCF
	RET

.TSTV2	LD	A,CMD8
	LD	DE,#01AA
	CALL	MMCCMD23
	LD	HL,MMCCMD1
	JR	C,.SKIP4
	LD	HL,MMCACM41
.SKIP4	LD	BC,120

.LOOP	PUSH	BC
	CALL	JUMPHL
	POP	BC
	JP	NC,INIT
	DJNZ	.LOOP
	DEC	C
	JR	NZ,.LOOP

ERR

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	SCF
	RET

JUMPHL	JP	(HL)

INIT	LD	A,CMD58
	LD	DE,0
	CALL	MMCCMD23
	JP	C,ERR
	LD	A,B
	AND	#40
	LD	(MMCVER),A
	CALL	Z,MMCST512

	LD	A,#FF
	OUT	(SPICON),A

	AND	A
	RET

MMCST512	SUBRO ///////////////////////////////// MMC SET BLOCK SIZE TO 512 BYTES

	LD	A,CMD16
	LD	BC,0
	LD	DE,512
	JP	MMCCMDGE

MMCREAD	SUBRO ////////////////////////////////////////////////// MMC READ BLOCK

;	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

;	CONVERT BLOCKS TO BYTES ACCORDING TO VERSION

	LD	A,(MMCVER)
	AND	A
	CALL	Z,MMCBYTES

;	READ BLOCK

	LD	A,CMD17
	CALL	MMCCMDGE
	RET	C

;	WAIT FE RESPONSE

	CALL	MMCWRFE
	RET	C

	LD	BC,SPIDAT
	INIR
	INIR

//	DISCARD CRC

	NOP
	IN	A,(SPIDAT)
	NOP
	IN	A,(SPIDAT)

	AND	A
	RET

MMCBYTES	SUBRO ///////////////////////////////////// MMC CONVERT BLOCKS TO BYTES

	LD	B,C
	LD	C,D
	LD	D,E
	LD	E,0
	SLA	D
	RL	C
	RL	B

	RET

MMCCMD1	SUBRO /////////////////////////////////////////////////// MMC SEND CMD1

	LD	A,CMD1

MMCCMDNA	LD	BC,0
	LD	D,B
	LD	E,C

MMCCMDGE	CALL	MMCCMD
	AND	A
	RET	Z
;	FALL THRU ERROR

MMCERROR	SCF
	RET

MMCACM41	SUBRO ///////////////////////////////////////////////// MMC SEND ACMD41

	LD	A,CMD55
	CALL	MMCCMDNA
	LD	A,ACMD41
	LD	BC,#4000
	LD	D,C
	LD	E,C
	JR	MMCCMDGE

MMCCMD2T	SUBRO ////////////////////////////// MMC SEND COMMAND 2 BYTES TEST BUSY

	LD	BC,0
	CALL	MMCCMD
	LD	B,A
	AND	#FE	; TEST BIT 0 (BUSY)
	LD	A,B
	JR	NZ,MMCERROR
	RET

MMCCMD23	SUBRO ///////////////////////////////// MMC SEND COMMAND 2 BYTES GET R3

	CALL	MMCCMD2T
	RET	C

	PUSH	AF
	CALL	MMCWRNFF
	LD	H,A
	CALL	MMCWRNFF
	LD	L,A
	CALL	MMCWRNFF
	LD	D,A
	CALL	MMCWRNFF
	LD	E,A
	LD	B,H
	LD	C,L
	POP	AF
	RET

MMCCMD	SUBRO //////////////////////////////////////////////// MMC SEND COMMAND

	OUT	(SPIDAT),A
	PUSH	AF
	LD	A,B
	NOP
	OUT	(SPIDAT),A
	LD	A,C
	NOP
	OUT	(SPIDAT),A
	LD	A,D
	NOP
	OUT	(SPIDAT),A
	LD	A,E
	NOP
	OUT	(SPIDAT),A
	POP	AF
	CP	CMD0
	LD	B,#95
	JR	Z,.CRC
	CP	CMD8
	LD	B,#87
	JR	Z,.CRC
	LD	B,#FF

.CRC	LD	A,B
	OUT	(SPIDAT),A
	JR	MMCWRNFF

MMCWRFE	SUBRO /////////////////////////////////////////// MMC WAIT RESPONSE #FE

	LD	B,10

.POLL	PUSH	BC
	CALL	MMCWRNFF
	POP	BC

	CP	#FE
	RET	Z

	DJNZ	.POLL

	SCF
	RET

MMCWRNFF	SUBRO /////////////////////////////////////// MMC WAIT RESPONSE NOT #FF

	LD	BC,100

.POLL	IN	A,(SPIDAT)
	CP	#FF
	RET	NZ
	DJNZ	.POLL

	DEC	C
	JR	NZ,.POLL

	RET

VDPCLS	SUBRO //////////////////////////////////////////////// VDP CLEAR SCREEN

	LD	DE,PNTBAS
	LD	BC,PNTLEN
	LD	A,SPC
	CALL	VDPFILL

	RET

VDPFILL	SUBRO //////////////////////////////////////////////////////// VDP FILL

	CALL	VDPSETW

	LD	D,A

.BYTE	LD	A,D
	OUT	(VDPDAT),A

	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPPRINT	SUBRO /////////////////////////////////////////////////////// VDP PRINT

	CALL	VDPSETW

.CHR	LD	A,(HL)
	AND	A
	RET	Z

	OUT	(VDPDAT),A
	INC	HL
	JR	.CHR

VDPCOPY	SUBRO //////////////////////////////////////////////////////// VDP COPY

	CALL	VDPSETW

.BYTE	LD	A,(HL)
	OUT	(VDPDAT),A
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPCOPYQ	SUBRO ////////////////////////////////////////////////// VDP COPY QUICK

	CALL	VDPSETW

	LD	C,VDPDAT
	OTIR

	RET

VDPSETW	SUBRO /////////////////////////////////////////////////// VDP SET WRITE

	PUSH	AF
	LD	A,E
	OUT	(VDPREG),A
	LD	A,D
	OR	#40
	OUT	(VDPREG),A
	POP	AF
	RET

VDPIMG	DEFB	%00000000
	DEFB	%10000010	; 16K VRAM | 16 X 16 SPRITES
	DEFB	PNTBAS>>10
	DEFB	PCTBAS>> 6
	DEFB	PGTBAS>>11
	DEFB	SATBAS>> 7
	DEFB	SGTBAS>>11
	DEFB	#00

PGTDAT	INCBIN	"PGT.BIN"

PCTDAT	DEFS	32,#F0

STRFAT16	DEFM	"FAT16   "
STRFAT32	DEFM	"FAT32   "

STRTTL	DEFM	"PHOENIX FIRMWARE STAGE -1",0

STRMMC0	DEFM	"SD CARD HANDSHAKE   WAIT",0
STRMMC1	DEFM	"SD CARD MBR         WAIT",0

STROK	DEFM	"OK  ",0
STRBAD	DEFM	"BAD ",0

	PAD	#2000

////////////////////////////////////////////////////////////////////////////////