	MACRO	SUBRO
	ENDMACRO

	MACRO	PAD ADDR
	DEFS	ADDR-$,#FF
	ENDMACRO

PGTBAS	EQU	#0000	; 2K
SGTBAS	EQU	#0800	; 2K
PNTBAS	EQU	#1000	; 768
SATBAS	EQU	#1300	; 128
PCTBAS	EQU	#1380	; 32

PGTLEN	EQU	2048
PCTLEN	EQU	32
PNTLEN	EQU	768

SPC	EQU	#29

/* MEMORY MAP *****************************************************************/

RAMBAS	EQU	#7000
RAMLEN	EQU	#0400

/* I/O MAP ********************************************************************/

JOYSET	EQU	#80	; -W- JOYPAD SET
VDPDAT	EQU	#BE	; RW- VDP DATA
VDPREG	EQU	#BF	; RW- VDP REGISTER SELECT / STATUS READ
JOYRES	EQU	#C0	; -W- JOYPAD RESET
JOY0DATS	EQU	#FC	; R-- JOYPAD 0
JOY1DATS	EQU	#FF	; R-- JOYPAD 1
PSGDAT	EQU	#FF	; -W- PSG DATA

	ORG	#0000

	LD	SP,RAMBAS+RAMLEN
	DI
	JP	START
	
	PAD	#0008
	RET
	PAD	#0010
	RET
	PAD	#0018
	RET
	PAD	#0020
	RET
	PAD	#0028
	RET
	PAD	#0030
	RET
	PAD	#0038
	EI
	RET		; RETI?

	PAD	#0066

	PUSH	AF
	IN	A,(VDPREG)
	POP	AF
	RETN

START

;	MUTE PSG ASAP (80 CYCLES)

	LD	A,%10011111
	OUT	(PSGDAT),A
	LD	A,%10111111
	OUT	(PSGDAT),A
	LD	A,%11011111
	OUT	(PSGDAT),A
	LD	A,%11111111
	OUT	(PSGDAT),A

;	CLEAR RAM

	LD	HL,RAMBAS
	LD	DE,RAMBAS+1
	LD	BC,RAMLEN-1
	LD	(HL),0
	LDIR

;	LOAD VDP IMAGE

	LD	HL,VDPIMG
	LD	BC,#0800|VDPREG
	LD	A,#80-1
.REG	INC	A		;  4 /  5 = 30
	OUTI			; 16 / 18
	JP	.WAIT		; 10 / 11 = 29
.WAIT	OUT	(VDPREG),A	; 11 / 12
	JR	NZ,.REG		; 12 / 13

;	UPLOAD GRAPHICS

	LD	HL,PGTDAT
	LD	DE,PGTBAS
	LD	BC,PGTLEN
	CALL	VDPCOPY

	LD	HL,PCTDAT
	LD	DE,PCTBAS
	LD	B,PCTLEN
	CALL	VDPCOPYQ
/*
	LD	HL,SPRDAT
	LD	DE,SGTBAS
	LD	BC,SGTLEN
	CALL	VDPCOPY
*/
	CALL	VDPCLS

	IN	A,(VDPREG)

	LD	A,%10100010	; ENABLE INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

	HALT

	LD	A,%11100010	; ENABLE DISPLAY & INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

FOREVER	JR	FOREVER

VDPCLS	SUBRO //////////////////////////////////////////////// VDP CLEAR SCREEN

	LD	DE,PNTBAS
	LD	BC,PNTLEN
	LD	A,SPC
	CALL	VDPFILL

	RET

VDPFILL	SUBRO //////////////////////////////////////////////////////// VDP FILL

	CALL	VDPSETW

	LD	D,A

.BYTE	LD	A,D
	OUT	(VDPDAT),A

	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPCOPY	SUBRO //////////////////////////////////////////////////////// VDP COPY

	CALL	VDPSETW

.BYTE	LD	A,(HL)
	OUT	(VDPDAT),A
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPCOPYQ	SUBRO ////////////////////////////////////////////////// VDP COPY QUICK

	CALL	VDPSETW

	LD	C,VDPDAT
	OTIR

	RET

VDPSETW	SUBRO /////////////////////////////////////////////////// VDP SET WRITE

	PUSH	AF
	LD	A,E
	OUT	(VDPREG),A
	LD	A,D
	OR	#40
	OUT	(VDPREG),A
	POP	AF
	RET

VDPIMG	DEFB	%00000000
	DEFB	%10000010	; 16K VRAM | 16 X 16 SPRITES
	DEFB	PNTBAS>>10
	DEFB	PCTBAS>> 6
	DEFB	PGTBAS>>11
	DEFB	SATBAS>> 7
	DEFB	SGTBAS>>11
	DEFB	#00

PGTDAT	INCBIN	"PGT.BIN"

PCTDAT	DEFS	32,#F0

	PAD	#2000

////////////////////////////////////////////////////////////////////////////////