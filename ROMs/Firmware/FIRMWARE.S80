/////////////////////////////////////////////////////////////////// DIP SWITCHES

DIPCORE	EQU	0

///////////////////////////////////////////////////////////////////////// MACROS

	MACRO	SUBRO
	ENDMACRO

	MACRO	PAD ADDR
	DEFS	ADDR-$,#FF
	ENDMACRO

	MACRO	LDXY X,Y
	LD	DE,PNTBAS+(Y*32)+X
	ENDMACRO

	MACRO	PRINT X,Y,STR
	LD	HL,STR
	LDXY	X,Y
	CALL	VDPPRINT
	ENDMACRO

	MACRO	ABORT X,Y,STR
	PRINT	X,Y,STR
	HALT
	ENDMACRO

//////////////////////////////////////////////////////////////////////// EQUATES

PGTBAS	EQU	#0000	; PATTERN GENERATOR TABLE BASE
SGTBAS	EQU	#0800	; SPRITE  GENERATOR TABLE BASE
PNTBAS	EQU	#1000	; PATTERN NAME      TABLE BASE
SATBAS	EQU	#1300	; SPRITE  ATTRIBUTE TABLE BASE
PCTBAS	EQU	#1380	; PATTERN COLOR     TABLE BASE

PGTLEN	EQU	2048	; PATTERN GENERATOR TABLE LENGTH
SGTLEN	EQU	2048	; SPRITE  GENERATOR TABLE LENGTH
PNTLEN	EQU	 768	; PATTERN NAME      TABLE LENGTH
SATLEN	EQU	 128	; SPRITE  ATTRIBUTE TABLE LENGTH
PCTLEN	EQU	  32	; PATTERN COLOR     TABLE LENGTH

SPC	EQU	' '	; SPACE

//////////////////////////////////////////////////////////////////////// STRUCTS

	MAP	RAMBAS

;SECBUF	#	512	; SECTOR BUFFER

CLUMSK	#	1	; CLUSTER SIZE
CLUSIZ	#	1	; CLUSTER MASK
DATBAS	#	4	; DATA BASE
DIRCLU	#	4	; DIRECTORY CLUSTER
DIRSEC	#	4	; DIRECTORY SECTOR
DIRENT	#	2	; DIRECTORY ENTRIES
ENTRY	#	2	; ENTRY INDEX
FATBAS	#	4	; FAT BASE
FATNUM	#	1	; NUMBER OF FATS
FATSIZ	#	2	; FAT SIZE
FILCLU	#	2	; FILE CLUSTER
FILSEC	#	4	; FILE SECTOR
FILSIZ	#	4	; FILE SIZE (BYTES)
FILESIZE	#	2	; FILE SIZE (SECTORS)
FILENAME	#	2	; FILENAME POINTER
FILEAREA	#	2	; FILENAME AREA
FIRST8	#	8
MMCVER	#	1	; MMC VERSION
PNTPTR	#	2	; PATTERN NAME TABLE POINTER
ROTBAS	#	4	; ROOT DIRECTORY BASE
ROTCLU	#	4	; ROOT DIRECTORY CLUSTER
ROTSIZ	#	1	; ROOT DIRECTORY SIZE
SECPTR	#	2	; SECTOR POINTER
SPICOMIR	#	1
SPICOMWC	#	1
SPICOMRC	#	1
SPICOMH	#	1
SPICOMM	#	1
SPICOML	#	1
SPICOMD	#	1
VBRBAS	#	4	; VBR BASE
SB	#	4

VARS	#	VARSZ	; VARIABLES

	ENDMAP

SECBUF	EQU	#C000

///////////////////////////////////////////////////////////////////// MEMORY MAP

RAMBAS	EQU	#7000	; RAM BASE
RAMLEN	EQU	#0400	; RAM LENGTH

//////////////////////////////////////////////////////////////////////// I/O MAP

SYSCON	EQU	#55	; -W- SYSTEM CONTROL
SYSSTA	EQU	#56	;     SYSTEM STATUS
SYSINF	EQU	#58	;     SYSTEM INFO (MACHINE ID)
SPIFLASH	EQU	#59	;     SPI FLASH
JOYSET	EQU	#80	; -W- JOYPAD SET
VDPDAT	EQU	#BE	; RW- VDP DATA
VDPREG	EQU	#BF	; RW- VDP REGISTER SELECT / STATUS READ
JOYRES	EQU	#C0	; -W- JOYPAD RESET
JOY0DAT	EQU	#FC	; R-- JOYPAD 0
JOY1DAT	EQU	#FF	; R-- JOYPAD 1
PSGDAT	EQU	#FF	; -W- PSG DATA

////////////////////////////////////////////////////////////////////// PAGE ZERO

	ORG	#0000

	LD	SP,RAMBAS+RAMLEN
	DI
	JP	START
	
	PAD	#0008
	RET

	PAD	#0010
	RET

	PAD	#0018
	RET

	PAD	#0020
	RET

	PAD	#0028
	RET

	PAD	#0030
	RET

//////////////////////////////////////////////////////////////////////////// INT

	PAD	#0038
	EI
	RET

//////////////////////////////////////////////////////////////////////////// NMI

	PAD	#0066

	PUSH	AF
	IN	A,(VDPREG)
	POP	AF
	RETN

START	LD	IY,VARS

;	MUTE PSG ASAP (80 CYCLES)

	LD	A,%10011111
	OUT	(PSGDAT),A
	LD	A,%10111111
	OUT	(PSGDAT),A
	LD	A,%11011111
	OUT	(PSGDAT),A
	LD	A,%11111111
	OUT	(PSGDAT),A

;	ENABLE LOADER & MULTI CART

	LD	A,3
	OUT	(SYSCON),A

;	CLEAR RAM

	LD	HL,RAMBAS
	LD	DE,RAMBAS+1
	LD	BC,RAMLEN-1
	LD	(HL),0
	LDIR

;	LOAD VDP IMAGE

	LD	HL,VDPIMG
	LD	BC,#0800|VDPREG
	LD	A,#80-1
.REG	INC	A		;  4 /  5 = 30
	OUTI			; 16 / 18
	JP	.WAIT		; 10 / 11 = 29
.WAIT	OUT	(VDPREG),A	; 11 / 12
	JR	NZ,.REG		; 12 / 13

;	UPLOAD GRAPHICS

	LD	HL,PGTDAT
	LD	DE,PGTBAS
	LD	BC,PGTLEN
	CALL	VDPCOPY

	LD	HL,PCTDAT
	LD	DE,PCTBAS
	LD	B,PCTLEN
	CALL	VDPCOPYQ
/*
	LD	HL,SPRDAT
	LD	DE,SGTBAS
	LD	BC,SGTLEN
	CALL	VDPCOPY
*/
	CALL	VDPCLS

	LD	HL,STRTTL
	LDXY	4,5
	CALL	VDPPRINT

;	ENABLE VIDEO+NMI

	IN	A,(VDPREG)

	LD	A,%10100010	; ENABLE INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

	HALT

;	LD	A,%11100010	; ENABLE DISPLAY & INT
	LD	A,%11000010	; ENABLE DISPLAY & NOT INT
	OUT	(VDPREG),A
	LD	A,#81
	OUT	(VDPREG),A

	INCLUDE	"PGM.S80"

;	UPLOAD JUMPER CODE TO RAM
/*
	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS
*/
;	JUMPER CODE

JUMPER	LD	A,%00000010
	OUT	(SYSCON),A

	JP	0

JUMPERE

//////////////////////////////////////////////////////////////////////// I/O MAP

SPICON	EQU	#56
SPIDAT	EQU	#57

	INCLUDE	"FAT.S80"
	INCLUDE	"SDC.S80"
	INCLUDE	"SPI.S80"
	INCLUDE	"SUB.S80"
	INCLUDE	"VDP.S80"

	INCLUDE	"DAT.S80"

	PAD	#2000

////////////////////////////////////////////////////////////////////////////////