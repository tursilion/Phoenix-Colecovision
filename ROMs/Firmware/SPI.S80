nCS	EQU	#01	; NOT CHIP SELECT
SCLK	EQU	#02	; SLAVE CLOCK
MOSI	EQU	#04	; MASTER OUT SLAVE IN
nWP	EQU	#08	; NOT WRITE PROTECT
nHOLD	EQU	#10	; NOT HOLD

CS	EQU	#00
nSCLK	EQU	#00
nMOSI	EQU	#00
WP	EQU	#00
HOLD	EQU	#00

/////////////////////////////////////////////////////////// SPI/QPI INSTRUCTIONS

SPI_WRITE_ENABLE              EQU	#06
SPI_VOLATILE_SR_WRITE_ENABLE  EQU	#50
SPI_WRITE_DISABLE             EQU	#04
SPI_READ_STATUS_REGISTER_1    EQU	#05 ; S07-0
SPI_WRITE_STATUS_REGISTER_1   EQU	#01 ; S07-0
SPI_READ_STATUS_REGISTER_2    EQU	#35 ; S15-8
SPI_WRITE_STATUS_REGISTER_2   EQU	#31 ; S15-8
SPI_READ_STATUS_REGISTER_3    EQU	#15 ; S23-16
SPI_WRITE_STATUS_REGISTER_3   EQU	#11 ; S23-16
SPI_CHIP_ERASE                EQU	#C7 ; ALSO #60
SPI_ERASE_PROGRAM_SUSPEND     EQU	#75
SPI_ERASE_PROGRAM_RESUME      EQU	#7A
SPI_POWER_DOWN                EQU	#B9
QPI_SET_READ_PARAMETERS       EQU	#C0 ; P7-0
SPI_RELEASE_POWER_DOWN_ID     EQU	#AB ; DUMMY  DUMMY  DUMMY  ID7-0
SPI_MANUFACTURER_DEVICE_ID    EQU	#90 ; DUMMY  DUMMY  #00    MF7-0  ID7-0
SPI_JEDEC_ID                  EQU	#9F ; MF7-0  ID15-8 ID7-0
SPI_GLOBAL_BLOCK_LOCK         EQU	#7E
SPI_GLOBAL_BLOCK_UNLOCK       EQU	#98
SPI_ENTER_QPI_MODE            EQU	#38
QPI_EXIT_QPI_MODE             EQU	#FF
SPI_ENABLE_RESET              EQU	#66
SPI_RESET_DEVICE              EQU	#99

SPI_READ_UNIQUE_ID            EQU	#4B ; DUMMY  DUMMY  DUMMY  DUMMY  UID63-0
SPI_PAGE_PROGRAM              EQU	#02 ; A23-16 A15-8  A7-0   D7-0   D7-0
SPI_QUAD_PAGE_PROGRAM         EQU	#32 ; A23-16 A15-8  A7-0   D7-0   D7-0
SPI_SECTOR_ERASE              EQU	#20 ; A23-16 A15-8  A7-0
SPI_32KB_BLOCK_ERASE          EQU	#52 ; A23-16 A15-8  A7-0
SPI_64KB_BLOCK_ERASE          EQU	#D8 ; A23-16 A15-8  A7-0
SPI_READ_DATA                 EQU	#03 ; A23-16 A15-8  A7-0   D7-0
SPI_FAST_READ                 EQU	#0B ; A23-16 A15-8  A7-0   DUMMY  D7-0
QPI_BURST_READ_WITH_WRAP      EQU	#0C ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_FAST_READ_QUAD_IO         EQU	#EB ; A23-16 A15-8  A7-0   M7-0   D7-0
SPI_FAST_READ_DUAL_OUTPUT     EQU	#3B ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_FAST_READ_QUAD_OUTPUT     EQU	#6B ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_READ_SFDP_REGISTER        EQU	#5A ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_ERASE_SECURITY_REGISTER   EQU	#44 ; A23-16 A15-8  A7-0
SPI_PROGRAM_SECURITY_REGISTER EQU	#42 ; A23-16 A15-8  A7-0   D7-0   D7-0
SPI_READ_SECURITY_REGISTER    EQU	#48 ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_INDIVIDUAL_BLOCK_LOCK     EQU	#36 ; A23-16 A15-8  A7-0
SPI_INDIVIDUAL_BLOCK_UNLOCK   EQU	#39 ; A23-16 A15-8  A7-0
SPI_READ_BLOCK_LOCK           EQU	#3D ; A23-16 A15-8  A7-0   L7-0

SPI_FAST_READ_DUAL_IO         EQU	#BB ; A23-16 A15-8  A7-0   DUMMY  D7-0
SPI_MFTR_DEVICE_ID_DUAL_IO    EQU	#92 ; A23-16 A15-8  A7-0   DUMMY  MF7-0  ID*

SPI_SET_BURST_WITH_WRAP       EQU	#77 ; DUMMY  DUMMY  DUMMY  W8-0
QPI_FAST_READ_QUAD_IO         EQU	#EB ; A23-16 A15-8  A7-0   M7-0   DUMMY  ...
SPI_WORD_READ_QUAD_IO         EQU	#E7 ; A23-16 A15-8  A7-0   M7-0   DUMMY  ...
SPI_OCTAL_READ_QUAD_IO        EQU	#E3 ; A23-16 A15-8  A7-0   M7-0   D7-0   ...
SPI_MFTR_DEVICE_ID_QUAD_IO    EQU	#94 ; A23-16 A15-8  A7-0   M7-0   DUMMY  ...

	MACRO	SPIOUT

	OUT	(SPIFLASH),A
;[8]	NOP

	ENDMACRO

SPICOM	SUBRO ; ///////////////////////////////////////////// SPI FLASH COMMAND

	LD	(SPICOMIR),A
	LD	(SPICOMWC),BC
	LD	(SPICOMH),DE
	LD	(SPICOML),HL

;	MODE 0 (DRIVE CLOCK LOW WHILE NOT CS) & WP

	LD	A,nHOLD|WP|nMOSI|nSCLK|nCS
	SPIOUT

;	ASSERT CS

	LD	A,nHOLD|WP|nMOSI|nSCLK|CS
	SPIOUT

;	1ST BYTE (INSTRUCTION)

	LD	A,(SPICOMIR)
	CALL	SPISER

;	2ND BYTE

	LD	A,(SPICOMWC)
	CP	1
	LD	A,(SPICOMH)
	CALL	NC,SPISER

;	3RD BYTE

	LD	A,(SPICOMWC)
	CP	2
	LD	A,(SPICOMM)
	CALL	NC,SPISER

;	4TH BYTE

	LD	A,(SPICOMWC)
	CP	3
	LD	A,(SPICOML)
	CALL	NC,SPISER

;	5TH BYTE

	LD	A,(SPICOMWC)
	CP	4
	LD	A,(SPICOMD)
	CALL	Z,SPISER

;	256-BYTE BLOCK

	LD	A,(SPICOMWC)
	CP	255
	JR	NZ,.NBLK

	LD	B,0
.BLK	PUSH	BC
	LD	A,(IX)
	CALL	SPISER
	INC	IX
	POP	BC
	DJNZ	.BLK
.NBLK
;	RETURN CODE

	LD	D,0

	LD	A,(SPICOMRC)
	AND	A
	JR	Z,.NRC

	LD	B,8

.RCBIT	LD	A,nHOLD|WP|nMOSI|nSCLK|CS
	SPIOUT

	SLA	D

	IN	A,(SPIFLASH)
	AND	1
	OR	D
	LD	D,A

	LD	A,B
	CP	1
	JR	Z,.SK1

	LD	A,nHOLD|WP|nMOSI|SCLK|CS
	SPIOUT
.SK1
	DJNZ	.RCBIT

	LD	E,0
.NRC
;	FINISH

	LD	A,nHOLD|WP|nSCLK|CS
	OR	E
	SPIOUT

	LD	A,nHOLD|WP|nSCLK|nCS
	OR	E
	SPIOUT

	LD	A,D
	RET

SPISER	SUBRO ; /////////////////////////////////////////// SPI FLASH SERIALIZE

	LD	D,A
	LD	B,8

.BIT	RLC	D
	LD	A,D
	AND	1
[2]	ADD	A,A
	LD	E,A

	OR	nHOLD|WP|nSCLK|CS
	SPIOUT

	OR	SCLK
	SPIOUT

	DJNZ	.BIT

	RET

SPIWAIT	SUBRO ; //////////////////////////////////////////////// SPI FLASH WAIT

;	LDXY	0,22
;	CALL	VDPSETW

	LD	A,SPI_READ_STATUS_REGISTER_1
	LD	BC,#0100
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

;	PUSH	AF
;	CALL	BCDPUT
;	POP	AF

	AND	1
	JR	NZ,SPIWAIT

	RET

; //////////////////////////////////////////////////////////////////////////////