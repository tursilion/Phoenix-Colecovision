BCDPUTAT	SUBRO ////////////////////////////////////////////////////// BCD PUT AT

	CALL	VDPSETW

BCDPUT	SUBRO ///////////////////////////////////////////////////////// BCD PUT

	PUSH	AF
[4]	SRL	A
	OUT	(VDPDAT),A
	POP	AF
	AND	#0F
	OUT	(VDPDAT),A
	RET

CHRPUTAT	SUBRO //////////////////////////////////////////////// CHARACTER PUT AT

	CALL	VDPSETW

CHRPUT	SUBRO /////////////////////////////////////////////////// CHARACTER PUT

	OUT	(VDPDAT),A

	RET

STRNPUT	SUBRO //////////////////////////////////////////////////// STRING N PUT

	LD	C,VDPDAT
	OTIR

	RET

VDPCLS	SUBRO //////////////////////////////////////////////// VDP CLEAR SCREEN

	LD	DE,PNTBAS
	LD	BC,PNTLEN
	LD	A,SPC
	CALL	VDPFILL

	RET

VDPFILL	SUBRO //////////////////////////////////////////////////////// VDP FILL

	CALL	VDPSETW

	LD	D,A

.BYTE	LD	A,D
	OUT	(VDPDAT),A

	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPPRINT	SUBRO /////////////////////////////////////////////////////// VDP PRINT

	CALL	VDPSETW

.CHR	LD	A,(HL)
	INC	HL
	AND	A
	RET	Z

	OUT	(VDPDAT),A
	JR	.CHR

VDPCOPY	SUBRO //////////////////////////////////////////////////////// VDP COPY

	CALL	VDPSETW

.BYTE	LD	A,(HL)
	OUT	(VDPDAT),A
	INC	HL
	DEC	BC
	LD	A,B
	OR	C
	JP	NZ,.BYTE

	RET

VDPCOPYQ	SUBRO ////////////////////////////////////////////////// VDP COPY QUICK

	CALL	VDPSETW

	LD	C,VDPDAT
	OTIR

	RET

VDPSETW	SUBRO /////////////////////////////////////////////////// VDP SET WRITE

	PUSH	AF
	LD	A,E
	OUT	(VDPREG),A
	LD	A,D
	OR	#40
	OUT	(VDPREG),A
	POP	AF
	RET

////////////////////////////////////////////////////////////////////////////////