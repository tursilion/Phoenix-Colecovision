////////////////////////////////////////////////////////////////////////////////

PGM

;	SD CARD VOLUME

	PRINT	04,08,STRFAT0

	CALL	FATRESET
	JR	NC,.RESETOK

	ABORT	24,08,STRBAD
.RESETOK	PRINT	24,08,STROK

;	MENU SYSTEM

	LD	HL,OPT.DATTOP
	LD	(OPTPTR),HL

.FOREVER	CALL	OPTRUN

	JR	.FOREVER






;	CORE 0 HOTKEYS

	IF	DIPCORE=0
/*
.SHOWME	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	LDXY	0,0
	CALL	BCDPUTAT

	OUT	(JOYRES),A
[4]	NOP
	IN	A,(JOY0DAT)
	LDXY	3,0
	CALL	BCDPUTAT

	JR	.SHOWME
*/
.WAITKEY	LD	D,0

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	LD	E,A
	AND	#0F

	CP	#0A	; 0
	JR	Z,.CORE

	CP	#0D	; 1
	JR	Z,.CORE01

	CP	#07	; 2
	JR	Z,.CORE02

	CP	#0C	; 3
	JR	Z,.CORE03

	CP	#02	; 4
	JR	Z,.CORE04

	CP	#03	; 5
	JR	Z,.CORE05

	CP	#0E	; 6
	JR	Z,.CORE06

	CP	#05	; 7
	JR	Z,.CORE07

	CP	#01	; 8
	JR	Z,.CORE08

	CP	#0B	; 9
	JR	Z,.CORE09

;	LD	E,#7F
;	JR	.CORE01	; NONE, REST

	JR	.WAITKEY

;	TRIGGER CORE

.CORE09	INC	D
.CORE08	INC	D
.CORE07	INC	D
.CORE06	INC	D
.CORE05	INC	D
.CORE04	INC	D
.CORE03	INC	D
.CORE02	INC	D
.CORE01	INC	D

.CORE	LD	A,E
	AND	#40
	JR	NZ,.BOOT

	OUT	(JOYRES),A
[4]	NOP
	IN	A,(JOY0DAT)
	AND	#40
	JR	Z,.FLASH

.BOOT	LD	A,D
	OR	#80	; STROBE HI
	OUT	(#5A),A
	LD	A,D	; STROBE LO
	OUT	(#5A),A

	HALT

;	FLASH CORE
/*
	PRINT	04,12,STRFAT2

	LD	HL,STRMULT	; DEFAULT: MULTI CART
*/
.FLASH	PUSH	DE
	LDXY	0,0
	CALL	VDPSETW
	POP	DE

	LD	A,D
	OUT	(VDPDAT),A

;	HALT

	PUSH	DE
	LDXY	0,1
	CALL	VDPSETW
	POP	DE

;	ERASE

	PUSH	DE

	LD	A,D
[3]	ADD	A,A
	LD	IYL,A
	LD	B,8		; 8X 64K SECTORS
.SPIDEL	PUSH	BC

	LD	A,'E'
	OUT	(VDPDAT),A

	LD	A,SPI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,SPI_64KB_BLOCK_ERASE
	LD	BC,3
	LD	E,IYL
	LD	D,0
	LD	HL,0
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IYL
	POP	BC
	DJNZ	.SPIDEL

	POP	DE

;	WRITE

	PUSH	DE

	LD	B,D
	LD	DE,11
	LD	HL,STRCOR00
	LD	A,B
	AND	A
	JR	Z,.NAMOK
.CORNAM	ADD	HL,DE
	DJNZ	.CORNAM

.NAMOK	PUSH	HL

	LDXY	0,2
	CALL	VDPSETW

	LD	BC,#0B00|VDPDAT
	OTIR
	POP	HL
	CALL	FATOPEN
	JR	NC,.GOWR

	HALT

.GOWR	LDXY	0,3
	CALL	VDPSETW

	POP	DE
	LD	IYL,D
	LD	IYH,0
[11]	ADD	IY,IY	; X 2048

	LD	BC,928
.WRITE	PUSH	BC

	LD	A,C
	AND	1
	JR	NZ,.NOPROG

	LD	A,'W'
	OUT	(VDPDAT),A
.NOPROG
	LD	HL,#8000
	LD	(FILEAREA),HL

	CALL	FATREAD

;	1ST SECTOR HALF

	LD	A,SPI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,SPI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8000
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	2ND SECTOR HALF

	LD	A,SPI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,SPI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8100
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	LOOP

	POP	BC
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,.WRITE

	LD	A,'D'
	OUT	(VDPDAT),A

;	HALT

	LD	HL,OPT.DATCORINS
	LD	(OPTPTR),HL
	RET

	ENDIF

	IF	DIPCORE!=0

;	BIOS FILE

	PRINT	04,10,STRFAT1

	LD	HL,STRBIOS
	LD	DE,#0000
	LD	BC,#2000/512
	CALL	FATLOAD
	JR	NC,.BIOSOK

	ABORT	24,10,STRBAD
.BIOSOK	PRINT	24,10,STROK

	ENDIF

	IF	DIPCORE=1
	LD	HL,STRMULT
	ENDIF

	IF	DIPCORE=2
	LD	HL,STRDK
	ENDIF

	IF	DIPCORE=3
	LD	HL,STRBT
	ENDIF

	IF	DIPCORE!=0

.LDITEM	LD	DE,#8000
	LD	BC,#4000/512
	CALL	FATLOAD
	JR	NC,.CARTOK

	ABORT	24,12,STRBAD
.CARTOK	PRINT	24,12,STROK

;	LAUNCH

	PRINT	15,23,STREND

	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS

	ENDIF

PGMVOID	RET
/*
.TSTJOY

	OUT	(JOYRES),A
[4]	NOP

	LDXY	0,23

	IN	A,(JOY0DAT)
	CALL	BCDPUTAT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A
	NOP
	OUT	(VDPDAT),A

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	JR	.TSTJOY

	HALT
*/
/*
	EXX
	LD	A,H
	LDXY	0,3
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	EXX

	LD	A,H
	CALL	BCDPUT
	LD	A,L
	CALL	BCDPUT
*/
/*
	LD	HL,SECBUF+#0180
	LDXY	0,4
	LD	B,16
.ROW	LD	A,H
	SUB	#70
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	LD	A,' '
	OUT	(VDPDAT),A
	LD	C,8
.B	LD	A,(HL)
	INC	HL
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	DEC	C
	JR	NZ,.B
	PUSH	HL
	LD	HL,32
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	DJNZ	.ROW
*/
/*
	MF: #EF
	9F: #7018 (#4018/#6018)
*/
SPIINF

	CALL	VDPCLS

	LD	HL,STRJEDEC
	LDXY	8,4
	CALL	VDPPRINT

	LD	A,SPI_JEDEC_ID
	LD	BC,#0100
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

;	LD	A,#EF
	LDXY	18,4
	CALL	BCDPUTAT

	HALT

////////////////////////////////////////////////////////////////////////////////