////////////////////////////////////////////////////////////////////////////////

;	SD CARD VOLUME

	PRINT	04,08,STRFAT0

	CALL	FATRESET
	JR	NC,.RESETOK

	ABORT	24,08,STRBAD
.RESETOK	PRINT	24,08,STROK

;	BIOS FILE

	PRINT	04,10,STRFAT1

	LD	HL,STRBIOS
	LD	DE,#0000
	LD	BC,#2000/512
	CALL	FATLOAD
	JR	NC,.BIOSOK

	ABORT	24,10,STRBAD
.BIOSOK	PRINT	24,10,STROK

;	CART FILE

	PRINT	04,12,STRFAT2

;	TRIGGER 2ND CORE (SLOT 1)

	LD	A,#81	; 0000 1--- ---- ---- ---- ---- #080000
	OUT	(#5A),A
	AND	#7F	; STROBE
	OUT	(#5A),A

	HALT
/*
	LD	HL,STRMULT	; DEFAULT: MULTI CART

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	AND	#0F
	CP	#0D
	JP	NZ,.LDITEM
*/
	LDXY	0,0
	CALL	VDPSETW

;	ERASE

	LD	B,8
;	LD	IYL,0
	LD	IYL,8
.SPIDEL	PUSH	BC

	LD	A,'E'
	OUT	(VDPDAT),A

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_64KB_BLOCK_ERASE
	LD	BC,3
	LD	E,IYL
	LD	D,0
	LD	HL,0
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IYL
	POP	BC
	DJNZ	.SPIDEL

;	WRITE

;	LD	HL,STRCOR00
	LD	HL,STRCOR01
	CALL	FATOPEN
	JR	NC,.GOWR

	HALT
.GOWR
	LDXY	0,2
	CALL	VDPSETW

	LD	BC,928
;	LD	IY,0
	LD	IY,2048
.WRITE	PUSH	BC

	LD	A,C
	AND	1
	JR	NZ,.NOPROG

	LD	A,'W'
	OUT	(VDPDAT),A
.NOPROG
	LD	HL,#8000
	LD	(FILEAREA),HL

	CALL	FATREAD

;	1ST SECTOR HALF

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8000
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	2ND SECTOR HALF

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8100
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	LOOP

	POP	BC
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,.WRITE

	LD	A,'D'
	OUT	(VDPDAT),A

	HALT
/*
	LD	HL,STRCART

.LDITEM	LD	DE,#8000
	LD	BC,#4000/512
	CALL	FATLOAD
	JR	NC,.CARTOK

	ABORT	24,12,STRBAD
.CARTOK	PRINT	24,12,STROK

;	LAUNCH

	PRINT	15,23,STREND

	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS
*/
/*
.TSTJOY

	OUT	(JOYRES),A
[4]	NOP

	LDXY	0,23

	IN	A,(JOY0DAT)
	CALL	BCDPUTAT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A
	NOP
	OUT	(VDPDAT),A

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	JR	.TSTJOY

	HALT
*/
/*
	EXX
	LD	A,H
	LDXY	0,3
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	EXX

	LD	A,H
	CALL	BCDPUT
	LD	A,L
	CALL	BCDPUT
*/
/*
	LD	HL,SECBUF+#0180
	LDXY	0,4
	LD	B,16
.ROW	LD	A,H
	SUB	#70
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	LD	A,' '
	OUT	(VDPDAT),A
	LD	C,8
.B	LD	A,(HL)
	INC	HL
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	DEC	C
	JR	NZ,.B
	PUSH	HL
	LD	HL,32
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	DJNZ	.ROW
*/
////////////////////////////////////////////////////////////////////////////////