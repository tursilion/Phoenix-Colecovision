	NOP
	OUT	(VDPDAT),A

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
