////////////////////////////////////////////////////////////////////////////////

;	SD CARD VOLUME

	PRINT	04,08,STRFAT0

	CALL	FATRESET
	JR	NC,.RESETOK

	ABORT	24,08,STRBAD
.RESETOK	PRINT	24,08,STROK

;	BIOS FILE

	PRINT	04,10,STRFAT1

	LD	HL,STRBIOS
	LD	DE,#0000
	LD	BC,#2000/512
	CALL	FATLOAD
	JR	NC,.BIOSOK

	ABORT	24,10,STRBAD
.BIOSOK	PRINT	24,10,STROK

;	CART FILE

	PRINT	04,12,STRFAT2

	LD	HL,STRMULT	; DEFAULT: MULTI CART

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	AND	#0F
	CP	#0D
	JP	NZ,.LDITEM
/*
	for (i = 0; i < 8; i++)
	{
		vdp_putchar('E');
		fiWR(FI_WRITE_ENABLE    , 0, 0, 0, 0, 0, 0);
		fiWR(FI_64KB_BLOCK_ERASE, 3, 0, i, 0, 0, 0);
		fiWait();
	}
*/
	LDXY	0,0
	CALL	VDPSETW

;	ERASE

	LD	B,8
	LD	IYL,0
.SPIDEL	PUSH	BC

	LD	A,'E'
	OUT	(VDPDAT),A

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_64KB_BLOCK_ERASE
	LD	BC,3
	LD	E,IYL
	LD	D,0
	LD	HL,0
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IYL
	POP	BC
	DJNZ	.SPIDEL

;	WRITE
/*
	for (i16 = 0; i16 < 928; i16++)
	{
		pbios = (unsigned char *) 0x8000;
		if (!FileRead(&file, pbios))
			erro("READ ERR");

		if ((i16 & 1) == 0) vdp_putchar('W');
		fiWR(FI_WRITE_ENABLE,   0, 0, 0, 0, 0, 0);
		fiWR(FI_PAGE_PROGRAM, 255, 0, (i16 << 1) >> 8, (i16 << 1) & 0xFF, 0, 0);
		fiWait();
		pbios = (unsigned char *) 0x8100;
		fiWR(FI_WRITE_ENABLE,   0, 0, 0, 0, 0, 0);
		fiWR(FI_PAGE_PROGRAM, 255, 0, (i16 << 1) >> 8, ((i16 << 1) & 0xFF) | 1, 0, 0);
		fiWait();

	}
*/
	LD	HL,STRCOR00
	CALL	FATOPEN
	JR	NC,.GOWR

	HALT
.GOWR
	LDXY	0,2
	CALL	VDPSETW

	LD	BC,928
	LD	IY,0
.WRITE	PUSH	BC

	LD	A,C
	AND	1
	JR	NZ,.NOPROG

	LD	A,'W'
	OUT	(VDPDAT),A
.NOPROG
	LD	HL,#8000
	LD	(FILEAREA),HL

	CALL	FATREAD
/*
		fiWR(FI_WRITE_ENABLE,   0, 0, 0, 0, 0, 0);
		fiWR(FI_PAGE_PROGRAM, 255, 0, (i16 << 1) >> 8, (i16 << 1) & 0xFF, 0, 0);
		fiWait();
*/
;	1ST SECTOR HALF

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8000
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	2ND SECTOR HALF

	LD	A,FI_WRITE_ENABLE
	LD	BC,0
	LD	DE,0
	LD	HL,0
	CALL	SPICOM

	LD	A,FI_PAGE_PROGRAM
	POP	BC
	PUSH	BC
	LD	D,IYL
	LD	E,IYH
	LD	BC,255
	LD	HL,0
	LD	IX,#8100
	CALL	SPICOM

	CALL	SPIWAIT

	INC	IY

;	LOOP

	POP	BC
	DEC	BC
	LD	A,B
	OR	C
	JR	NZ,.WRITE

	LD	A,'D'
	OUT	(VDPDAT),A

	HALT

	LD	HL,STRCART	; 1: BURGER TIME

.LDITEM	LD	DE,#8000
	LD	BC,#4000/512
	CALL	FATLOAD
	JR	NC,.CARTOK

	ABORT	24,12,STRBAD
.CARTOK	PRINT	24,12,STROK

;	LAUNCH

	PRINT	15,23,STREND

	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS
/*
.TSTJOY

	OUT	(JOYRES),A
[4]	NOP

	LDXY	0,23

	IN	A,(JOY0DAT)
	CALL	BCDPUTAT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A
	NOP
	OUT	(VDPDAT),A

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	CALL	BCDPUT

	LD	A,SPC
	OUT	(VDPDAT),A

	IN	A,(JOY1DAT)
	CALL	BCDPUT

	JR	.TSTJOY

	HALT
*/
/*
	EXX
	LD	A,H
	LDXY	0,3
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	EXX

	LD	A,H
	CALL	BCDPUT
	LD	A,L
	CALL	BCDPUT
*/
/*
	LD	HL,SECBUF+#0180
	LDXY	0,4
	LD	B,16
.ROW	LD	A,H
	SUB	#70
	CALL	BCDPUTAT
	LD	A,L
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	LD	A,' '
	OUT	(VDPDAT),A
	LD	C,8
.B	LD	A,(HL)
	INC	HL
	CALL	BCDPUT
	LD	A,' '
	OUT	(VDPDAT),A
	DEC	C
	JR	NZ,.B
	PUSH	HL
	LD	HL,32
	ADD	HL,DE
	EX	DE,HL
	POP	HL
	DJNZ	.ROW
*/
////////////////////////////////////////////////////////////////////////////////