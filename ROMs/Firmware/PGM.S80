////////////////////////////////////////////////////////////////////////////////

;	SD CARD VOLUME

	PRINT	04,08,STRFAT0

	CALL	FATRESET
	JR	NC,.RESETOK

	ABORT	24,08,STRBAD
.RESETOK	PRINT	24,08,STROK

;	BIOS FILE

	PRINT	04,10,STRFAT1

	LD	HL,STRBIOS
	LD	DE,#0000
	LD	BC,#2000/512
	CALL	FATLOAD
	JR	NC,.BIOSOK

	ABORT	24,10,STRBAD
.BIOSOK	PRINT	24,10,STROK

;	CART FILE

	PRINT	04,12,STRFAT2

	LD	HL,STRMULT	; DEFAULT: MULTI CART

	OUT	(JOYSET),A
[4]	NOP
	IN	A,(JOY0DAT)
	AND	#0F
	CP	#0D
	JR	NZ,.LDITEM

	LD	HL,STRCART	; 1: BURGER TIME

.LDITEM	LD	DE,#8000
	LD	BC,#4000/512
	CALL	FATLOAD
	JR	NC,.CARTOK

	ABORT	24,12,STRBAD
.CARTOK	PRINT	24,12,STROK

;	LAUNCH

	PRINT	15,23,STREND

	LD	HL,JUMPER
	LD	DE,RAMBAS
	LD	BC,JUMPERE-JUMPER
	LDIR

	JP	RAMBAS
