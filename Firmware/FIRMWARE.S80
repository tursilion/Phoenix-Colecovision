///////////////////////////////////////////////////////////////////// MEMORY MAP

RAMBAS	EQU	#7000

//////////////////////////////////////////////////////////////////////// I/O MAP

SPICON	EQU	#56
SPIDAT	EQU	#57

////////////////////////////////////////////////////////////////////// VARIABLES

	MAP	RAMBAS

MMCTYPE	#	1

	ENDMAP

/////////////////////////////////////////////////////////////////// SPI COMMANDS

CMD0	EQU	 0|#40
CMD1	EQU	 1|#40
CMD8	EQU	 8|#40
CMD9	EQU	 9|#40
CMD10	EQU	10|#40
CMD12	EQU	12|#40
CMD16	EQU	16|#40
CMD17	EQU	17|#40
CMD18	EQU	18|#40
CMD24	EQU	24|#40
CMD25	EQU	25|#40
CMD55	EQU	55|#40
CMD58	EQU	58|#40
ACMD23	EQU	23|#40
ACMD41	EQU	41|#40

MMCRESET	SUBRO /////////////////////////////////////////////////////// MMC RESET

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

//	SEND 80 CLOCK PULSES

	LD	B,10

.INICLK	LD	A,#FF		; MOSI = 1
	OUT	(SPIDAT),A
	DJNZ	.INICLK

//	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

//	TRY 16 TIMES TO SEND CMD0

	LD	B,16

.CMD0X16	LD	A,CMD0
	LD	DE,0
	PUSH	BC
	CALL	MMCCMD2T
	POP	BC
	JP	NC,.TSTV2
	DJNZ	.CMD0X16

//	NO RESPONSE TO CMD0

	LD	L,0

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	RET

.TSTV2	LD	A,CMD8
	LD	DE,#01AA
	CALL	MMCCMD23
	LD	HL,MMCCMD1
	JR	C,.PULA4		; CARTAO RECUSOU CMD8, ENVIAR COMANDO CMD1
	LD	HL,MMCACM41	; CARTAO ACEITOU CMD8, ENVIAR COMANDO ACMD41
.PULA4	LD	BC,120		; 120 TENTATIVAS

.LOOP	PUSH	BC
	CALL	.JUMPHL
	POP	BC
	JP	NC,INICIOU
	DJNZ	.LOOP
	DEC	C
	JR	NZ,.LOOP

DEUERROI	LD	L,0

//	DISABLE SD

	LD	A,#FF
	OUT	(SPICON),A

	RET

.JUMPHL	JP	(HL)

INICIOU	LD	A,CMD58	; LER OCR
	LD	DE,0
	CALL	MMCCMD23	; ENVIAR COMANDO E RECEBER RESPOSTA TIPO R3
	JP	C,DEUERROI
	LD	A,B	; TESTA BIT CCS DO OCR QUE INFORMA SE CARTAO EH SDV1 OU SDV2
	AND	#40
	LD	(MMCTYPE),A	; SALVA INFORMACAO DA VERSAO DO SD (V1 OU V2)
	CALL	Z,MMCST512	; SE BIT CCS DO OCR FOR 1, EH CARTAO SDV2 (BLOCK ADDRESS - SDHC OU SDXD)
										; E NAO PRECISAMOS MUDAR TAMANHO DO BLOCO PARA 512
	LD	A,#FF
	OUT	(SPICON),A	; DESABILITA SD
	LD	A,(MMCTYPE)	; RETORNAR TIPO DE CARTAO
	LD	L,3
	CP	#40
	RET	Z
	LD	L,2
	RET

MMCST512	SUBRO ///////////////////////////////// MMC SET BLOCK SIZE TO 512 BYTES

	LD	A,CMD16
	LD	BC,0
	LD	DE,512
	JP	MMCCMDGE

MMCREAD	SUBRO ////////////////////////////////////////////////// MMC READ BLOCK


	LD	IY,0
	ADD	IY,SP
	LD	E (IY+2)
	LD	D,(IY+3)
	LD	C,(IY+4)
	LD	B,(IY+5)
	LD	L,(IY+6)
	LD	H,(IY+7)

;	ENABLE SD

	LD	A,#FE
	OUT	(SPICON),A

;	CONVERT BLOCKS TO BYTES ACCORDING TO VERSION

	LD	A,(MMCTYPE)
	OR	A
	CALL	Z,MMCBYTES

	LD	A,CMD17	; READ SINGLE BLOCK
	CALL	MMCCMDGE
	JR	NC,.OK2

.ERRO2	LD	L,0
	RET

.OK2	CALL	MMCWRFE
	JR	C,.ERRO2
	LD	BC,SPIDAT
	INIR
	INIR

//	DISCARD CRC

	NOP
	IN	A,(SPIDAT)
	NOP
	IN	A,(SPIDAT)

	LD	L,1
	RET

MMCBYTES	SUBRO ///////////////////////////////////// MMC CONVERT BLOCKS TO BYTES

	LD	B,C
	LD	C,D
	LD	D,E
	LD	E,0
	SLA	D
	RL	C
	RL	B

	RET

MMCCMD1	SUBRO /////////////////////////////////////////////////// MMC SEND CMD1

	LD	A,CMD1

MMCCMDNA	LD	BC,0
	LD	D,B
	LD	E,C

MMCCMDGE	CALL	MMCCMD
	OR	A
	RET	Z								; SE A=0 NAO HOUVE ERRO, RETORNAR
;	FALL THRU ERROR

MMCERROR	SCF
	RET

MMCACM41	SUBRO ///////////////////////////////////////////////// MMC SEND ACMD41

	LD	A,CMD55
	CALL	MMCCMDNA
	LD	A,ACMD41
	LD	BC,#4000
	LD	D,C
	LD	E,C
	JR	MMCCMDGE

MMCCMD2T	SUBRO ////////////////////////////// MMC SEND COMMAND 2 BYTES TEST BUSY

	LD	BC,0
	CALL	MMCCMD
	LD	B,A
	AND	#FE	; TEST BIT 0 (BUSY)
	LD	A,B
	JR	NZ,MMCERROR
	RET									; SEM ERROS

MMCCMD23	SUBRO ///////////////////////////////// MMC SEND COMMAND 2 BYTES GET R3

	CALL	MMCCMD2T
	RET	C

	PUSH	AF
	CALL	MMCWRNFF
	LD	H,A
	CALL	MMCWRNFF
	LD	L,A
	CALL	MMCWRNFF
	LD	D,A
	CALL	MMCWRNFF
	LD	E,A
	LD	B,H
	LD	C,L
	POP	AF
	RET

MMCCMD	SUBRO //////////////////////////////////////////////// MMC SEND COMMAND

	OUT	(SPIDAT),A
	PUSH	AF
	LD	A,B
	NOP
	OUT	(SPIDAT),A
	LD	A,C
	NOP
	OUT	(SPIDAT),A
	LD	A,D
	NOP
	OUT	(SPIDAT),A
	LD	A,E
	NOP
	OUT	(SPIDAT),A
	POP	AF
	CP	CMD0
	LD	B,#95
	JR	Z,.CRC
	CP	CMD8
	LD	B,#87
	JR	Z,.CRC
	LD	B,#FF

.CRC	LD	A,B
	OUT	(SPIDAT),A
	JR	MMCWRNFF

MMCWRFE	SUBRO /////////////////////////////////////////// MMC WAIT RESPONSE #FE

	LD	B,10

.POLL	PUSH	BC
	CALL	MMCWRNFF
	POP	BC

	CP	#FE
	RET	Z

	DJNZ	.LOOP1

	SCF
	RET

MMCWRNFF	SUBRO /////////////////////////////////////// MMC WAIT RESPONSE NOT #FF

	LD	BC,100

.POLL	IN	A,(SPIDAT)
	CP	#FF
	RET	NZ								; SAI SE NAO FOR $FF
	DJNZ	.POLL

	DEC	C
	JR	NZ,.POLL

	RET

////////////////////////////////////////////////////////////////////////////////