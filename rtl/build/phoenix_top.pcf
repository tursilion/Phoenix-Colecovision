        TS_clock_50m0_i_net / 2.5 PHASE 4 ns HIGH 50%;
TS_clock_system_clkout1 = PERIOD TIMEGRP "clock_system_clkout1"
        TS_clock_50m0_i_net / 2 HIGH 50%;
